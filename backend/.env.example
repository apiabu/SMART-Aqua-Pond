PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=YOUR_MYSQL_USERNAME
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=smart_aqua_pond

